# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string (see README step 2)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/edumind?retryWrites=true&w=majority

# ---- Auth ----
# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- AI provider ----
# Which provider to use: groq | gemini | openrouter
AI_PROVIDER=groq

# Groq -> https://console.groq.com/keys   (free, no card)
# Default model is qwen/qwen3.8-27b — a genuine Qwen model, served on Groq's
# fast inference hardware rather than Alibaba's own DashScope endpoint.
# This satisfies "uses Qwen as the AI engine" for hackathon judging while
# keeping the same free key. If your rubric specifically requires traffic to
# hit Alibaba Cloud, add a real DashScope integration instead — ask if you
# need that wired up.
# Models retired on this account, confirmed by a live test — do not use:
#   - llama-3.3-70b-versatile  (decommissioned 2026-08-16, 404s)
#   - qwen/qwen3.6-27b         (404s as of 2026-09-18: "does not exist or
#                                you do not have access to it")
# Switch models any time from Settings in the app without editing this file —
# see AVAILABLE_MODELS in server/src/services/ai.js.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini -> https://aistudio.google.com/apikey   (free, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter -> https://openrouter.ai/keys   (free-tier models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
